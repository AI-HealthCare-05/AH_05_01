<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 걸음/계단 감지에 필요한 권한 (Android 10+ 필수) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- 서버 통신에 필요한 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 백그라운드에서 계속 실행되는 서비스를 위한 권한 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13(API 33) 이상은 알림을 띄우려면 이 권한이 별도로 필요 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 달리기 거리(GPS) 측정에 필요한 위치 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".TmtnApplication"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TMTNv1">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TMTNv1"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 걸음·계단·달리기를 백그라운드에서 계속 측정하는 서비스.
             health(걸음/계단)와 location(달리기 GPS) 두 타입을 동시에 선언 -->
        <service
            android:name=".sensor.MissionSensorService"
            android:foregroundServiceType="health|location"
            android:exported="false" />
    </application>

</manifest>