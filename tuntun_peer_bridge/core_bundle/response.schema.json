{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ageTopCoded": {
      "type": "boolean"
    },
    "availableComponentCount": {
      "maximum": 4,
      "minimum": 0,
      "type": "integer"
    },
    "availableComponents": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "type": "array"
    },
    "comparisonKey": {
      "type": "string"
    },
    "components": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "absoluteReferenceScore": {
            "maximum": 100,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "componentKey": {
            "enum": [
              "physical",
              "diabetes",
              "hypertension",
              "lifestyle",
              "muscle"
            ]
          },
          "direction": {
            "enum": [
              "higher_is_healthier",
              "higher_is_more_not_healthier"
            ]
          },
          "display": {
            "additionalProperties": false,
            "properties": {
              "percentile": {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              "text": {
                "type": "string"
              },
              "topPercentApprox": {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "percentile",
              "topPercentApprox",
              "text"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "displayPolicyVersion": {
            "type": "string"
          },
          "formulaVersion": {
            "type": "string"
          },
          "includedInComposite": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "modelVersion": {
            "type": "string"
          },
          "peerPercentile": {
            "maximum": 100,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "percentileRange": {
            "items": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": [
              "array",
              "null"
            ]
          },
          "referenceEffectiveN": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "referenceGroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "referenceN": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "referenceVersion": {
            "type": "string"
          },
          "source": {
            "enum": [
              "questionnaire",
              "model_inference",
              "synthetic",
              "unavailable"
            ]
          },
          "tieMassPercent": {
            "maximum": 100,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "topPercentApprox": {
            "maximum": 100,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "unavailableReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "valueType": {
            "enum": [
              "health_direction_peer_percentile",
              "quantity_peer_percentile"
            ]
          }
        },
        "required": [
          "componentKey",
          "label",
          "direction",
          "includedInComposite",
          "valueType",
          "absoluteReferenceScore",
          "peerPercentile",
          "topPercentApprox",
          "percentileRange",
          "tieMassPercent",
          "referenceGroup",
          "referenceN",
          "referenceEffectiveN",
          "available",
          "unavailableReason",
          "modelVersion",
          "referenceVersion",
          "formulaVersion",
          "displayPolicyVersion",
          "source",
          "display"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 4,
      "type": "array"
    },
    "displayPolicyVersion": {
      "type": "string"
    },
    "formulaVersion": {
      "type": "string"
    },
    "isPartialScore": {
      "type": "boolean"
    },
    "isSynthetic": {
      "type": "boolean"
    },
    "lifestyleAvailableSubcomponentCount": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "modelVersion": {
      "type": "string"
    },
    "notice": {
      "type": "string"
    },
    "peerCompositeScore": {
      "maximum": 100,
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "referencePopulation": {
      "type": "string"
    },
    "referenceVersion": {
      "type": "string"
    },
    "referenceYears": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "type": "array"
    },
    "releaseStatus": {
      "const": "LOCAL_REVIEW_CANDIDATE"
    },
    "schemaVersion": {
      "const": "tuntun-peer-v0.1"
    },
    "scoreAvailable": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "formulaVersion",
    "displayPolicyVersion",
    "modelVersion",
    "referenceVersion",
    "referenceYears",
    "referencePopulation",
    "components",
    "peerCompositeScore",
    "availableComponents",
    "availableComponentCount",
    "isPartialScore",
    "scoreAvailable",
    "ageTopCoded",
    "lifestyleAvailableSubcomponentCount",
    "comparisonKey",
    "isSynthetic",
    "releaseStatus",
    "notice"
  ],
  "type": "object"
}
